<mujoco model="ur3e_rig">
    <compiler angle="radian" meshdir="assets" autolimits="true"/>
    <option integrator="implicitfast"/>

    <include file="ur3e_meta.xml"/>

  <visual>
    <headlight diffuse="1.0 1.0 1.0"  ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

<worldbody>
    <geom name="table" type="cylinder" size="0.45085 0.005" pos="0 0 -0.005" rgba=".1 .5 .1 1"/>
    
    <body pos="-0.4 -0.4 0">
        <include file="ur3e_body.xml"/>
    </body>
    <camera name="cam1" pos="0.5 0.0 0.5" xyaxes="1 0 0 0 0 1"/>
</worldbody>
</mujoco>
